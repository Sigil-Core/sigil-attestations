{
  "name": "sigil-attestations",
  "version": "0.2.1-rc.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sigil-Core/sigil-attestations.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "ATTESTATION-CONTRACT.md",
    "README.md",
    "RELEASE-CANDIDATE.md",
    "LICENSE"
  ],
  "bin": {
    "sigil-verify": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:packed-cli": "node scripts/test-packed-cli.mjs"
  },
  "dependencies": {
    "@sigilcore/warrant-core": "0.4.0",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "warrant-core-0-2-1-fixture": "npm:@sigilcore/warrant-core@0.2.1",
    "warrant-core-0-2-3-fixture": "npm:@sigilcore/warrant-core@0.2.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
